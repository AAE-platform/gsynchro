{
  "name": "gsynchro",
  "version": "0.3.0",
  "description": "Bidirectional sync of selected project files with a locally mounted folder",
  "keywords": [
    "sync",
    "synchronization",
    "google-drive",
    "rclone",
    "cli",
    "documentation",
    "governance"
  ],
  "license": "MIT",
  "author": "Federico Villi",
  "homepage": "https://github.com/fvilli/gsynchro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fvilli/gsynchro.git"
  },
  "bugs": {
    "url": "https://github.com/fvilli/gsynchro/issues"
  },
  "type": "module",
  "bin": {
    "gsynchro": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGE_LOG.md",
    "LICENSE",
    "schema.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node -e \"const fs=require('fs');fs.rmSync('test-results',{recursive:true,force:true});fs.mkdirSync('test-results')\" && tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=test-results/report.txt \"test/**/*.test.ts\"",
    "gsynchro": "tsx src/cli.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
